# Copy this file to .env and fill in the values. Never share .env or commit it.

# Supabase dashboard -> Project Settings -> Data API -> Project URL
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Supabase dashboard -> Project Settings -> API Keys -> Secret key (sb_secret_...)
# (or the legacy "service_role" key). Server-only: it bypasses all security rules.
SUPABASE_SECRET_KEY=

# Optional
SUPABASE_BUCKET=documents
PORT=8000
# Set to 1 when the site is served over HTTPS
COOKIE_SECURE=0
