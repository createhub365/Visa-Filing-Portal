{
  // Cloudflare Worker: serves static/ and the /api backend (worker/index.js).
  // Secret (set in Cloudflare dashboard, never here): SUPABASE_SECRET_KEY
  "name": "visa-filing-portal",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./static",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "SUPABASE_URL": "https://qigeyjpxkmleroxbhclm.supabase.co",
    "SUPABASE_BUCKET": "documents",
    "COOKIE_SECURE": "1"
  },
  "observability": { "enabled": true }
}
